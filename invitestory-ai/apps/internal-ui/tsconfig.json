{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@invitestory/contracts": ["../../packages/contracts/src"],
      "@invitestory/ingest": ["../../packages/ingest/src"],
      "@invitestory/extraction": ["../../packages/extraction/src"],
      "@invitestory/templates": ["../../packages/templates/src"],
      "@invitestory/compiler": ["../../packages/compiler/src"],
      "@invitestory/sandbox": ["../../packages/sandbox/src"],
      "@invitestory/browser-qa": ["../../packages/browser-qa/src"],
      "@invitestory/visual-qa": ["../../packages/visual-qa/src"],
      "@invitestory/model-router": ["../../packages/model-router/src"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}