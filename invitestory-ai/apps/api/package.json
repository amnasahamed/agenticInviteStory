{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:push": "wrangler d1 execute invitestory-db --local --file=./migrations/schema.sql",
    "db:studio": "wrangler d1 execute invitestory-db --local --command=\"SELECT * FROM jobs LIMIT 10\""
  },
  "dependencies": {
    "@invitestory/contracts": "workspace:*",
    "@invitestory/ingest": "workspace:*",
    "@invitestory/extraction": "workspace:*",
    "@invitestory/templates": "workspace:*",
    "@invitestory/compiler": "workspace:*",
    "@invitestory/sandbox": "workspace:*",
    "@invitestory/browser-qa": "workspace:*",
    "@invitestory/visual-qa": "workspace:*",
    "@invitestory/model-router": "workspace:*",
    "hono": "^4.0.0",
    "zod": "^3.22.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2024000.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "wrangler": "^3.0.0"
  }
}