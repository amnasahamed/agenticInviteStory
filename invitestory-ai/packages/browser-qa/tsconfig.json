{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@invitestory/contracts": ["../contracts/dist"],
      "@invitestory/ingest": ["../ingest/dist"],
      "@invitestory/extraction": ["../extraction/dist"],
      "@invitestory/templates": ["../templates/dist"],
      "@invitestory/compiler": ["../compiler/dist"],
      "@invitestory/agent-tasks": ["../agent-tasks/dist"],
      "@invitestory/sandbox": ["../sandbox/dist"],
      "@invitestory/browser-qa": ["../browser-qa/dist"],
      "@invitestory/visual-qa": ["../visual-qa/dist"],
      "@invitestory/model-router": ["../model-router/dist"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
